{
  "name": "pdf-forge",
  "version": "1.2.0",
  "description": "PDF Forge - Free open-source Adobe Acrobat style PDF editor for Windows",
  "main": "src/main/main.js",
  "author": "Hillyard Tech",
  "license": "MIT",
  "scripts": {
    "start": "concurrently \"webpack serve --mode=development\" \"wait-on http://localhost:9000 && electron .\"",
    "build:renderer": "webpack --mode=production",
    "build": "npm run build:renderer && electron-builder --win",
    "package": "npm run build:renderer && electron-builder --win --dir"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.7.1",
    "@embedpdf/pdfium": "^2.15.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^3.11.174",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tesseract.js": "^5.1.1",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.6",
    "@babel/preset-env": "^7.23.6",
    "@babel/preset-react": "^7.23.3",
    "babel-loader": "^9.1.3",
    "canvas": "^3.2.3",
    "concurrently": "^8.2.2",
    "css-loader": "^6.8.1",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "electron-packager": "^17.1.2",
    "html-webpack-plugin": "^5.6.0",
    "style-loader": "^3.3.3",
    "wait-on": "^7.2.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  }
}
